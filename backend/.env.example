# 服务
CRM_SERVER_PORT=8080
CRM_SERVER_MODE=debug

# PostgreSQL
CRM_DATABASE_HOST=localhost
CRM_DATABASE_PORT=5432
CRM_DATABASE_USER=crm
CRM_DATABASE_PASSWORD=crm_password
CRM_DATABASE_DBNAME=crm_db
CRM_DATABASE_SSLMODE=disable

# Redis
CRM_REDIS_HOST=localhost
CRM_REDIS_PORT=6379
CRM_REDIS_PASSWORD=
CRM_REDIS_DB=0

# JWT
CRM_JWT_SECRET=change-me-in-production-please
CRM_JWT_ACCESS_TTL=3600
CRM_JWT_REFRESH_TTL=604800

# 日志
CRM_LOG_LEVEL=info

# MinIO（对象存储）
CRM_MINIO_ENDPOINT=localhost:9000
CRM_MINIO_ACCESS_KEY=minio
CRM_MINIO_SECRET_KEY=minio_password
CRM_MINIO_BUCKET=crm-files
CRM_MINIO_USESSL=false

# Cloudflare Turnstile
CRM_TURNSTILE_SECRET=your-turnstile-secret-key
CRM_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify