{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRM Desktop - 拉新端",
  "version": "0.1.0",
  "identifier": "com.crm.desktop-lead",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "418前端",
        "width": 580,
        "height": 680,
        "minWidth": 400,
        "minHeight": 500,
        "maxWidth": 1200,
        "maxHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "fs": {
      "scope": [
        "$APPDATA/*",
        "$APPLOCALDATA/*",
        "$DOWNLOADS/*",
        "$DOCUMENT/*",
        "$PICTURE/*"
      ]
    }
  }
}
