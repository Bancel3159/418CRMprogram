{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRM Desktop - 维护端",
  "version": "0.1.0",
  "identifier": "com.crm.desktop-follow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5275",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CRM 维护客户端",
        "width": 1280,
        "height": 850,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "clipboard-manager": {
      "all": true
    }
  }
}